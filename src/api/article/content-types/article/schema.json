{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Every Resources piece: blog posts, news, guides and tools."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 320,
      "required": true
    },
    "hub": {
      "type": "enumeration",
      "enum": [
        "blog",
        "news",
        "guides",
        "tools"
      ],
      "default": "blog",
      "required": true
    },
    "template": {
      "type": "enumeration",
      "enum": [
        "explainer",
        "opinion",
        "news_post",
        "product_update",
        "guide",
        "how_to",
        "top_list",
        "checklist",
        "comparison",
        "case_study",
        "tool",
        "glossary",
        "faq_page",
        "data_report",
        "message_templates",
        "myth_vs_fact",
        "roundup",
        "interview"
      ],
      "default": "explainer",
      "required": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "displayDate": {
      "type": "date"
    },
    "readingMinutes": {
      "type": "integer",
      "min": 1
    },
    "reviewStatus": {
      "type": "enumeration",
      "enum": [
        "placeholder",
        "needs_fact_check",
        "approved"
      ],
      "default": "placeholder"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blocks.rich-text",
        "blocks.tldr",
        "blocks.key-takeaways",
        "blocks.callout",
        "blocks.conclusion",
        "blocks.spec-table",
        "blocks.grid-table",
        "blocks.checklist",
        "blocks.steps",
        "blocks.ranked-list",
        "blocks.pros-cons",
        "blocks.stats",
        "blocks.quote",
        "blocks.faq",
        "blocks.chat-example",
        "blocks.message-template",
        "blocks.before-after",
        "blocks.explainer",
        "blocks.definition",
        "blocks.timeline",
        "blocks.image",
        "blocks.video",
        "blocks.html-embed",
        "blocks.cta",
        "blocks.related-links",
        "blocks.sources"
      ]
    },
    "news": {
      "type": "component",
      "repeatable": false,
      "component": "meta.news"
    },
    "guide": {
      "type": "component",
      "repeatable": false,
      "component": "meta.guide"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  },
  "pluginOptions": {}
}
